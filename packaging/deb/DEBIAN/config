#!/bin/sh
# Perguntas da instalação (debconf). Pré-configurar sem perguntas:
#   echo "legis legis/municipio string Tuntum" | sudo debconf-set-selections
set -e
. /usr/share/debconf/confmodule

db_input high legis/uf || true
