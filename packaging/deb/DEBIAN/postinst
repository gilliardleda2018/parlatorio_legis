#!/bin/bash
# Instalação/configuração do pacote legis.
set -e
. /usr/share/debconf/confmodule

APP=/opt/legis
DADOS=/var/lib/legis
ETC=/etc/legis
ENVF=$ETC/legis.env

[ "$1" = "configure" ] || exit 0

db_get legis/uf;            UF=$(echo "$RET" | tr 'A-Z' 'a-z' | tr -cd 'a-z')
db_get legis/municipio;     MUNICIPIO="$RET"
db_get legis/nome;          NOME="$RET"
db_get legis/radio;         RADIO="$RET"
db_get legis/transcricao;   TRANSCRICAO="$RET"
db_get legis/ia;            IA="$RET"
db_get legis/tailscale_chave; CHAVE="$RET"
db_set legis/tailscale_chave ""   # a chave não fica guardada no debconf
JITSI=true; db_get legis/jitsi && JITSI="$RET" || true
YT_CHAVE=""; db_get legis/youtube_chave && YT_CHAVE="$RET" || true
db_set legis/youtube_chave "" || true
YT_LINK=""; db_get legis/youtube_link && YT_LINK="$RET" || true
db_stop

slug() { python3 -c "import re,sys,unicodedata as u; t=''.join(c for c in u.normalize('NFD',sys.argv[1]) if u.category(c)!='Mn').lower(); print(re.sub(r'[^a-z0-9]+','-',t).strip('-'))" "$1"; }
[ -n "$NOME" ] || NOME=$(slug "${MUNICIPIO:-legis}")
NOME=$(slug "$NOME")

# modelo da cidade: o da instalação direta (instalar-legis.sh --modelo) ou o que veio no pacote da Câmara
MODELO_ARQ=""
for M in "$ETC/modelo/camara.json" /usr/share/legis/cidade/modelo.json; do
  [ -f "$M" ] && { MODELO_ARQ="$M"; break; }
done
TLS_EXTRAS=""
if [ -n "$MODELO_ARQ" ]; then
  if OK=$(python3 "$APP/packaging/modelo.py" validar "$MODELO_ARQ" 2>&1); then
    echo "LEGIS: modelo da cidade — ${OK#ok: }"
    TLS_EXTRAS=$(python3 -c "import json,sys; print(','.join(json.load(open(sys.argv[1]))['certificado']['nomesExtras']))" "$MODELO_ARQ" 2>/dev/null || true)
  else
    echo "LEGIS: modelo da cidade ignorado: $OK"; MODELO_ARQ=""
  fi
fi

getent group legis >/dev/null || addgroup --system legis >/dev/null
getent passwd legis >/dev/null || adduser --system --ingroup legis --home "$DADOS" --no-create-home --shell /usr/sbin/nologin legis >/dev/null
mkdir -p "$DADOS" "$ETC"
chown legis:legis "$DADOS"; chmod 750 "$DADOS"

porta_livre() { ! (ss -ltnH 2>/dev/null | awk '{print $4}' | grep -qE "(^|:)$1\$"); }
if [ ! -f "$ENVF" ]; then
  PIN=$(python3 -c "import secrets; print(str(secrets.randbelow(10**8)).zfill(8))")
  HTTP=80;  porta_livre 80  || HTTP=8090
  HTTPS=443; porta_livre 443 || HTTPS=8443
  IPS=$(hostname -I 2>/dev/null | tr ' ' ',' | sed 's/,$//')
  cat > "$ENVF" <<EOF
# Configuração do LEGIS desta Câmara. Depois de mudar: sudo systemctl restart legis
PARLATORIO_BANCO=$DADOS/legis.db
PIN_PRESIDENTE=$PIN
PORTA=$HTTP
PORTA_HTTPS=$HTTPS
HTTPS=auto
TLS_NOMES=$(hostname).local,$(hostname),${IPS}${TLS_EXTRAS:+,$TLS_EXTRAS}
LEGIS_NOME=$NOME
TZ=America/Sao_Paulo
PROXY_CONFIAVEL=1
PROXY_IPS=127.0.0.1,::1
EOF
  chmod 640 "$ENVF"; chgrp legis "$ENVF"
fi
if [ -n "$MODELO_ARQ" ]; then   # atualização ou modelo novo: o servidor só aplica o modelo uma vez por banco
  sed -i '/^LEGIS_MODELO=/d' "$ENVF"; printf 'LEGIS_MODELO=%s\n' "$MODELO_ARQ" >> "$ENVF"
  grep -q '^LEGIS_NOME=' "$ENVF" || printf 'LEGIS_NOME=%s\n' "$NOME" >> "$ENVF"
  if [ -n "$TLS_EXTRAS" ]; then   # nomes do certificado pedidos no modelo, sem repetir os que já estão
    python3 - "$ENVF" "$TLS_EXTRAS" <<'PY'
import sys
from pathlib import Path
arq, extras = Path(sys.argv[1]), [n for n in sys.argv[2].split(",") if n]
linhas = arq.read_text().splitlines()
for k, linha in enumerate(linhas):
    if linha.startswith("TLS_NOMES="):
        nomes = [n for n in linha[10:].split(",") if n]
        linhas[k] = "TLS_NOMES=" + ",".join(nomes + [n for n in extras if n not in nomes])
arq.write_text("\n".join(linhas) + "\n")
PY
  fi
fi

# CHAVE='valor' (o ' vira '\''): "legis extras" lê sem executar (le_conf em /usr/sbin/legis)
aspas() { printf "'%s'" "$(printf %s "$1" | tr -d '\n' | sed "s/'/'\\\\''/g")"; }
for CHAVE in UF MUNICIPIO NOME TRANSCRICAO IA JITSI; do
  printf '%s=%s\n' "$CHAVE" "$(aspas "${!CHAVE}")"
done > "$ETC/instalacao.conf"

# vereadores eleitos (TSE) e população (IBGE): só num banco novo — ou no banco de exemplo
# criado quando a instalação foi feita sem o município (ex.: instalador gráfico, que não pergunta nada)
if [ -n "$UF" ] && [ -n "$MUNICIPIO" ] && [ -f "$DADOS/legis.db" ] && [ -f "$DADOS/.sem-municipio" ]; then
  if [ -d /run/systemd/system ]; then systemctl stop legis.service || true; fi
  ANTES="$DADOS/legis.db.exemplo-$(date +%Y%m%d%H%M%S)"
  mv "$DADOS/legis.db" "$ANTES"
  rm -f "$DADOS/legis.db-wal" "$DADOS/legis.db-shm"
  echo "LEGIS: o banco de exemplo foi guardado em $ANTES"
fi
EMBUTIDOS=/usr/share/legis/cidade/dados.json   # só no pacote personalizado de uma Câmara
if [ -n "$UF" ] && [ -n "$MUNICIPIO" ] && [ ! -f "$DADOS/legis.db" ]; then
  if [ -f "$EMBUTIDOS" ]; then echo "LEGIS: configurando $MUNICIPIO/${UF^^} com os dados do pacote..."
  else echo "LEGIS: buscando os vereadores eleitos de $MUNICIPIO/${UF^^} no TSE..."; fi
  DO_PACOTE=(); [ -f "$EMBUTIDOS" ] && DO_PACOTE=("LEGIS_CIDADE_DADOS=$EMBUTIDOS")
  [ -n "$MODELO_ARQ" ] && DO_PACOTE+=("LEGIS_MODELO=$MODELO_ARQ")
  if ! runuser -u legis -- env PARLATORIO_BANCO="$DADOS/legis.db" TRANSCRICAO=0 "${DO_PACOTE[@]}" \
       python3 "$APP/scripts/tse_eleitos.py" "$UF" "$MUNICIPIO" "$DADOS/legis.db"; then
    rm -f "$DADOS/legis.db"
    echo "LEGIS: não foi possível importar agora (internet?). Depois rode: sudo dpkg-reconfigure legis"
    touch "$DADOS/.sem-municipio"
  else
    rm -f "$DADOS/.sem-municipio"
  fi
elif [ ! -f "$DADOS/legis.db" ]; then
  touch "$DADOS/.sem-municipio"   # sem município: começa com dados de exemplo; reconfigurar depois troca
fi

# rádio da Câmara (Liquidsoap): programação + sessão ao vivo, servida pelo próprio LEGIS em /radio.mp3
if [ "$RADIO" = "true" ]; then
  if command -v liquidsoap >/dev/null; then
    mkdir -p "$DADOS/radio/programacao"
    HTTP_LEGIS=$(grep '^PORTA=' "$ENVF" | cut -d= -f2)
    sed -e "s|@DIR@|$DADOS/radio/programacao|" -e "s|@PORTA@|${HTTP_LEGIS:-80}|" -e "s|@RADIO_PORTA@|8001|" \
      "$APP/deploy/radio/radio.liq" > "$DADOS/radio/radio.liq"
    chown -R legis:legis "$DADOS/radio"
    grep -q '^RADIO_LOCAL=' "$ENVF" || printf 'RADIO_LOCAL=1\nRADIO_PORTA=8001\nRADIO_DIR=%s\n' "$DADOS/radio/programacao" >> "$ENVF"
    RADIO_OK=1
  else
    echo "LEGIS: o Liquidsoap não está instalado; a rádio fica desligada (sudo apt install liquidsoap && sudo dpkg-reconfigure legis)."
  fi
fi

# YouTube: o LEGIS adota a chave ao subir (só ela muda no painel depois); fica no legis.env, legível só pelo serviço
if [ -n "$YT_CHAVE" ] || [ -n "$YT_LINK" ]; then
  sed -i '/^LEGIS_YOUTUBE_\(CHAVE\|LINK\)=/d' "$ENVF"
  [ -n "$YT_CHAVE" ] && printf 'LEGIS_YOUTUBE_CHAVE=%s\n' "$(printf %s "$YT_CHAVE" | tr -cd 'A-Za-z0-9_-')" >> "$ENVF"
  [ -n "$YT_LINK" ] && printf 'LEGIS_YOUTUBE_LINK=%s\n' "$(printf %s "$YT_LINK" | tr -d ' \n')" >> "$ENVF"
fi
unset YT_CHAVE

if [ -n "$CHAVE" ]; then
  umask 077; printf %s "$CHAVE" > "$DADOS/.tailscale-chave"; umask 022
fi
unset CHAVE

# certificado HTTPS criado já na instalação (cada Câmara tem o seu: a chave nunca sai deste servidor) e o kit
# para instalar nos aparelhos sem internet: /var/lib/legis/certificado-aparelhos (sudo legis certificado)
if [ -d /run/systemd/system ]; then systemctl stop legis.service 2>/dev/null || true; fi
if runuser -u legis -- bash -c 'set -a; . "$1"; set +a; exec python3 "$2/server/servidor.py" --kit-certificado "$3"' _ \
     "$ENVF" "$APP" "$DADOS/certificado-aparelhos" >/dev/null 2>&1; then
  echo "LEGIS: certificado HTTPS pronto; kit para os aparelhos em $DADOS/certificado-aparelhos"
else
  echo "LEGIS: o certificado será criado na primeira partida do serviço."
fi

if [ -d /run/systemd/system ]; then
  systemctl daemon-reload
  systemctl enable legis.service >/dev/null 2>&1 || true
  systemctl restart legis.service
  if [ "${RADIO_OK:-0}" = 1 ]; then
    systemctl enable legis-radio.service >/dev/null 2>&1 || true
    systemctl restart legis-radio.service || true
  fi
  systemctl enable avahi-daemon >/dev/null 2>&1 || true
  PORTAL_PENDENTE=""   # Câmara com portal legislativomunicipal.com ainda não importado (sessões, matérias, ex-vereadores)
  if [ ! -f "$DADOS/.portal-importado" ] && [ -f "$DADOS/legis.db" ] && \
     python3 -c "import json,sqlite3,sys; l=sqlite3.connect(sys.argv[1]).execute('select json from estado where id=1').fetchone(); sys.exit(0 if l and (json.loads(l[0]).get('casa') or {}).get('portal') else 1)" "$DADOS/legis.db" 2>/dev/null; then
    PORTAL_PENDENTE=1
  fi
  if [ "$TRANSCRICAO" = "true" ] || [ "$IA" = "true" ] || [ "$JITSI" = "true" ] || [ -f "$DADOS/.tailscale-chave" ] || [ -n "$PORTAL_PENDENTE" ]; then
    systemd-run --unit=legis-extras --collect --quiet /usr/sbin/legis extras || true
    EXTRAS=" (dados do portal da Câmara, transcrição, IA, videoconferência e internet terminam em segundo plano: sudo legis estado)"
  fi
fi

# endereço local para os atalhos do menu (legível por todos; legis.env não é)
HTTPS_P=$(grep '^PORTA_HTTPS=' "$ENVF" | cut -d= -f2)
if [ "${HTTPS_P:-443}" = 443 ]; then echo "https://localhost" > "$ETC/endereco-local"; else echo "https://localhost:$HTTPS_P" > "$ETC/endereco-local"; fi
chmod 644 "$ETC/endereco-local" "$ETC/instalacao.conf"

# instalado sem município (ex.: clique duplo no .deb, que não pergunta nada): abre o configurador
# gráfico na sessão de quem está usando a tela. Não abre quando é o próprio configurador que reconfigura.
if [ -f "$DADOS/.sem-municipio" ] && [ -z "${LEGIS_CONFIGURADOR:-}" ] && command -v loginctl >/dev/null; then
  for SID in $(loginctl list-sessions --no-legend 2>/dev/null | awk '{print $1}'); do
    TIPO=$(loginctl show-session "$SID" -p Type --value 2>/dev/null || true)
    ATIVA=$(loginctl show-session "$SID" -p Active --value 2>/dev/null || true)
    U=$(loginctl show-session "$SID" -p Name --value 2>/dev/null || true)
    if [ "$ATIVA" = yes ] && { [ "$TIPO" = x11 ] || [ "$TIPO" = wayland ]; } && [ -n "$U" ] && [ "$U" != root ]; then
      systemd-run --user --machine="$U@.host" --collect --quiet /usr/bin/legis-configurar --se-preciso >/dev/null 2>&1 \
        && echo "LEGIS: a janela de configuração foi aberta na tela de $U." || true
      break
    fi
  done
fi

LEGIS_SEM_PIN=1 /usr/sbin/legis resumo || true   # o PIN não vai para o registro do apt
echo "${EXTRAS:-}"
exit 0
