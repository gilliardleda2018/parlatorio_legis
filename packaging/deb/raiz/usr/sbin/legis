#!/bin/bash
# Administração do LEGIS instalado pelo pacote .deb.
#   legis              estado, endereços e o que está instalado
#   legis logs         registro do serviço (Ctrl-C para sair)
#   legis reiniciar    reinicia o serviço
#   legis importar-tse UF "Município"   vereadores eleitos (só num banco vazio)
#   legis reconfigurar perguntas da instalação de novo (dpkg-reconfigure legis)
#   legis extras       instala transcrição, IA local e publicação na internet escolhidas
#   legis importar-portal [url]  sessões, matérias e ex-vereadores do portal da Câmara (legislativomunicipal.com)
#   legis certificado [pasta]   kit do certificado para os aparelhos (copia para a pasta, ex.: pendrive)
#   legis modelo [--reaplicar]  modelo da cidade em uso; --reaplicar aplica de novo as preferências
set -euo pipefail
APP=/opt/legis
DADOS=/var/lib/legis
ETC=/etc/legis
ENVF=$ETC/legis.env
LOG=/var/log/legis-extras.log
# imagens dos contêineres com versão fixa (troque aqui, ou na variável, para atualizar)
OLLAMA_IMAGEM="${OLLAMA_IMAGEM:-ollama/ollama:0.5.7}"
TAILSCALE_IMAGEM="${TAILSCALE_IMAGEM:-tailscale/tailscale:v1.76.6}"

le() { grep -E "^$1=" "$2" 2>/dev/null | tail -1 | cut -d= -f2-; }
# instalacao.conf sem executar: aceita CHAVE='valor' (com '\'' dentro) e o formato antigo CHAVE=valor
le_conf() {
  local v; v=$(le "$1" "$ETC/instalacao.conf") || v=""   # chave ausente (arquivo antigo): vazio
  if [ "${#v}" -ge 2 ] && [ "${v:0:1}" = "'" ] && [ "${v: -1}" = "'" ]; then
    v=${v:1:${#v}-2}; v=${v//"'\''"/"'"}
  fi
  printf '%s' "$v"
}
root() { [ "$(id -u)" = 0 ] || { echo "Use: sudo legis $*"; exit 1; }; }
reiniciar() { if [ -d /run/systemd/system ]; then systemctl restart legis.service; fi; }

resumo() {
  local http https ip pin url
  http=$(le PORTA "$ENVF"); https=$(le PORTA_HTTPS "$ENVF"); pin=$(le PIN_PRESIDENTE "$ENVF")
  # na instalação (postinst) o PIN não aparece: o registro do apt fica guardado
  [ "${LEGIS_SEM_PIN:-0}" = 1 ] && pin="veja com  sudo grep PIN_PRESIDENTE $ENVF"
  ip=$(hostname -I 2>/dev/null | awk '{print $1}')
  url=$(cat "$ETC/endereco-internet" 2>/dev/null || true)
  local suf=""; [ "$https" != "443" ] && suf=":$https"
  local hsuf=""; [ "${http:-80}" != "80" ] && hsuf=":$http"
  cat <<EOF

 LEGIS — Sistema de Gestão Parlamentar
 ------------------------------------------------------------------
 Abrir o LEGIS:   https://$ip$suf   (rede da Câmara; também https://$(hostname).local$suf)
 1º acesso:       http://$ip$hsuf/certificado   (em cada aparelho: instala o certificado e abre o LEGIS)
 Internet:        ${url:-não publicado (sudo dpkg-reconfigure legis, com a chave do Tailscale)}
 Presidente:      /presidente — PIN inicial: ${pin:-?} (troque no primeiro acesso)
 Vereadores:      /parlamentar — PIN inicial de cada um em Plenário → PINs iniciais (troca obrigatória)
 Rádio:           $( grep -q '^RADIO_LOCAL=1' "$ENVF" 2>/dev/null && echo "https://$(hostname).local$suf/radio.mp3 (programação em Configurações → Rádio da Câmara)" || echo "não instalada")
 Checklist:       /usr/share/doc/legis/README.md
EOF
  if [ -f "$DADOS/.sem-municipio" ]; then
    cat <<EOF

 PRÓXIMO PASSO: escolher a cidade. Abra o painel do presidente (endereço acima +
 /presidente): a caixa "De qual cidade é esta Câmara?" traz os vereadores do TSE.
 (ou, no servidor: sudo dpkg-reconfigure legis)
EOF
  fi
}

estado() {
  resumo
  echo " ------------------------------------------------------------------"
  if [ -d /run/systemd/system ]; then
    printf " Serviço:         %s\n" "$(systemctl is-active legis.service 2>/dev/null || true)"
    printf " Instalação extra: %s\n" "$(systemctl is-active legis-extras.service 2>/dev/null | sed 's/inactive/concluída/;s/activating\|active/em andamento/')"
  fi
  [ -x "$DADOS/whisper/bin/python" ] && echo " Transcrição:     instalada" || echo " Transcrição:     não instalada"
  grep -q '^IA=ollama' "$ENVF" 2>/dev/null && echo " IA local:        instalada (Ollama)" || echo " IA local:        não instalada"
  if grep -q '^JITSI_URL=' "$ENVF" 2>/dev/null; then echo " Videoconferência: $(grep '^JITSI_URL=' "$ENVF" | cut -d= -f2-)"; else echo " Videoconferência: não instalada"; fi
  grep -q '^LEGIS_YOUTUBE_CHAVE=' "$ENVF" 2>/dev/null && echo " YouTube:         chave configurada (botão Transmitir do painel)" || echo " YouTube:         cole a chave em Configurações → YouTube ao vivo"
  if grep -q '^RADIO_LOCAL=1' "$ENVF" 2>/dev/null; then
    printf " Rádio:           %s — /radio.mp3, %s arquivo(s) na programação\n" \
      "$( [ -d /run/systemd/system ] && systemctl is-active legis-radio.service 2>/dev/null || echo instalada)" \
      "$(find "$DADOS/radio/programacao" -type f 2>/dev/null | wc -l)"
  else
    echo " Rádio:           não instalada"
  fi
  [ -f "$LOG" ] && { echo " Últimas linhas de $LOG:"; tail -3 "$LOG" | sed 's/^/   /'; }
  echo
}

portal_do_banco() {   # endereço do portal legislativomunicipal.com guardado na Câmara (vazio se não houver)
  [ -f "$DADOS/legis.db" ] || return 0
  python3 - "$DADOS/legis.db" <<'PY' 2>/dev/null || true
import json, re, sqlite3, sys
linha = sqlite3.connect(f"file:{sys.argv[1]}?mode=ro", uri=True).execute("select json from estado where id = 1").fetchone()
url = (json.loads(linha[0]).get("casa") or {}).get("portal", "") if linha else ""
print(url if re.fullmatch(r"https://(www\.)?[a-z0-9-]{2,60}\.legislativomunicipal\.com", url or "") else "")
PY
}

importar_portal() {   # sessões, matérias, ex-vereadores e presença do portal da Câmara (como em Tuntum)
  local url="${1:-$(portal_do_banco)}"
  [ -n "$url" ] || { echo "portal: esta Câmara não tem portal legislativomunicipal.com cadastrado."; return 1; }
  [[ "$url" =~ ^https://(www\.)?[a-z0-9-]{2,60}\.legislativomunicipal\.com$ ]] || { echo "portal: endereço inválido: $url"; return 1; }
  echo "portal: importando sessões, matérias e ex-vereadores de $url (alguns minutos; o LEGIS para enquanto isso)..."
  [ -d /run/systemd/system ] && systemctl stop legis.service
  local ok=0
  if runuser -u legis -- env PARLATORIO_BANCO="$DADOS/legis.db" TRANSCRICAO=0 BACKUP_HORA= \
       python3 -u "$APP/scripts/importar_portal_camara.py" "$url" "$DADOS/legis.db"; then   # -u: o log mostra o andamento
    touch "$DADOS/.portal-importado"; ok=1; echo "portal: importado"
  else
    echo "portal: a importação falhou (o portal está no ar?). Tente de novo com  sudo legis importar-portal"
  fi
  [ -d /run/systemd/system ] && systemctl start legis.service
  [ "$ok" = 1 ]
}

extras() {
  root extras
  exec >>"$LOG" 2>&1
  echo "== $(date '+%F %T') instalação extra =="
  local TRANSCRICAO IA JITSI NOME
  TRANSCRICAO=$(le_conf TRANSCRICAO); IA=$(le_conf IA); JITSI=$(le_conf JITSI); NOME=$(le_conf NOME)
  local mudou=0 marcas; marcas=$(mktemp -d)
  # primeiro os dados reais do portal da Câmara (uma vez só; depois, sudo legis importar-portal atualiza)
  if [ ! -f "$DADOS/.portal-importado" ] && [ -n "$(portal_do_banco)" ]; then
    importar_portal || true
  fi
  # videoconferência, IA e internet precisam do Docker respondendo: liga e espera (até 1 min) antes de começar
  if command -v docker >/dev/null && ! docker info >/dev/null 2>&1; then
    [ -d /run/systemd/system ] && systemctl enable --now docker.socket docker.service >/dev/null 2>&1 || true
    for _ in $(seq 1 30); do docker info >/dev/null 2>&1 && break; sleep 2; done
    docker info >/dev/null 2>&1 || echo "Docker não respondeu; videoconferência, IA e internet ficam para o próximo  sudo legis extras"
  fi
  # Transcrição, IA e videoconferência baixam em paralelo (são os passos demorados: ~600 MB, ~2 GB e ~1 GB).
  # Cada um marca o que concluiu; o legis.env só é escrito depois do wait (o Jitsi também mexe nele).
  if [ "${TRANSCRICAO:-false}" = "true" ] && [ ! -x "$DADOS/whisper/bin/python" ]; then
    (
      echo "transcrição: instalando faster-whisper e o modelo small..."
      runuser -u legis -- env PARLATORIO_DADOS="$DADOS" HOME="$DADOS" HF_HOME="$DADOS/hf" sh "$APP/scripts/instalar_transcricao.sh" \
        && touch "$marcas/transcricao" && echo "transcrição: pronta"
    ) 2>&1 | sed -u 's/^/[transcrição] /' &
  fi
  local ia_quer=0
  if [ "${IA:-false}" = "true" ] && ! grep -q '^IA=ollama' "$ENVF"; then
    if command -v docker >/dev/null; then
      ia_quer=1
      (
        echo "IA: iniciando o Ollama e baixando qwen2.5:3b (cerca de 2 GB)..."
        docker inspect legis-ollama >/dev/null 2>&1 || docker run -d --name legis-ollama --restart unless-stopped \
          -e OLLAMA_KEEP_ALIVE=30m -p 127.0.0.1:11434:11434 -v "$DADOS/ollama:/root/.ollama" "$OLLAMA_IMAGEM"
        for _ in $(seq 1 30); do docker exec legis-ollama ollama list >/dev/null 2>&1 && break; sleep 2; done
        docker exec legis-ollama ollama pull qwen2.5:3b && touch "$marcas/ia" && echo "IA: pronta"
      ) 2>&1 | sed -u 's/^/[IA] /' &
    else
      echo "IA: o Docker não está instalado (sudo apt install docker.io) — pulando."
    fi
  fi
  if [ "${JITSI:-false}" = "true" ] && ! grep -q '^JITSI_URL=' "$ENVF"; then
    if command -v docker >/dev/null; then
      (
        echo "videoconferência: instalando o Jitsi da Câmara (cerca de 1 GB)..."
        ENVF="$ENVF" SERVICO=legis SEM_REINICIAR=1 JITSI_DIR="$DADOS/jitsi" DADOS="$DADOS" bash "$APP/deploy/jitsi/instalar-jitsi.sh" \
          && touch "$marcas/jitsi" && echo "videoconferência: pronta"
      ) 2>&1 | sed -u 's/^/[videoconferência] /' &
    else
      echo "videoconferência: o Docker não está instalado (sudo apt install docker.io) — pulando."
    fi
  fi
  wait
  [ -f "$marcas/transcricao" ] && mudou=1
  [ -f "$marcas/jitsi" ] && mudou=1
  if [ "$ia_quer" = 1 ] && [ -f "$marcas/ia" ]; then
    printf 'IA=ollama\nOLLAMA_URL=http://127.0.0.1:11434\nIA_MODELO=qwen2.5:3b\n' >> "$ENVF"
    mudou=1
  fi
  rm -rf "$marcas"
  if [ -f "$DADOS/.tailscale-chave" ]; then
    if command -v docker >/dev/null; then
      echo "internet: publicando pelo Tailscale Funnel como ${NOME}..."
      local https; https=$(le PORTA_HTTPS "$ENVF")
      mkdir -p "$DADOS/tailscale"
      cat > "$DADOS/tailscale/serve.json" <<EOF
{ "TCP": { "443": { "HTTPS": true } },
  "Web": { "\${TS_CERT_DOMAIN}:443": { "Handlers": { "/": { "Proxy": "https+insecure://127.0.0.1:${https:-443}" } } } },
  "AllowFunnel": { "\${TS_CERT_DOMAIN}:443": true } }
EOF
      docker rm -f legis-tailscale >/dev/null 2>&1 || true
      # a chave vai num arquivo só-leitura (TS_AUTHKEY=file:…), não no ambiente: não aparece no docker inspect.
      # TS_AUTH_ONCE: depois de entrar, o contêiner não precisa mais dela (o arquivo é apagado abaixo)
      local segredo="$DADOS/tailscale-segredo"
      install -d -m 0700 "$segredo"
      install -m 0600 "$DADOS/.tailscale-chave" "$segredo/chave"
      rm -f "$DADOS/.tailscale-chave"
      docker run -d --name legis-tailscale --restart unless-stopped --network host \
        -e TS_AUTHKEY=file:/run/legis-segredo/chave -e TS_AUTH_ONCE=true -e TS_HOSTNAME="$NOME" -e TS_USERSPACE=true \
        -e TS_STATE_DIR=/var/lib/tailscale -e TS_SERVE_CONFIG=/var/lib/tailscale/serve.json \
        -v "$segredo:/run/legis-segredo:ro" -v "$DADOS/tailscale:/var/lib/tailscale" "$TAILSCALE_IMAGEM"
      for _ in $(seq 1 40); do
        local dns; dns=$(docker exec legis-tailscale tailscale status --json 2>/dev/null | python3 -c "import json,sys; print(json.load(sys.stdin)['Self']['DNSName'].rstrip('.'))" 2>/dev/null || true)
        if [ -n "$dns" ]; then echo "https://$dns" > "$ETC/endereco-internet"; echo "internet: https://$dns"; break; fi
        sleep 3
      done
      if [ -s "$ETC/endereco-internet" ] && [ -n "${dns:-}" ]; then
        rm -f "$segredo/chave"   # já entrou na rede: a chave não é mais necessária
      else
        # não entrou a tempo: a chave volta para o lugar, para a próxima tentativa (sudo legis extras)
        install -m 0600 "$segredo/chave" "$DADOS/.tailscale-chave" 2>/dev/null || true
        echo "internet: o Tailscale não respondeu a tempo; rode de novo: sudo legis extras"
      fi
    else
      echo "internet: o Docker não está instalado (sudo apt install docker.io) — pulando."
    fi
  fi
  [ "$mudou" = 1 ] && reiniciar
  echo "== concluído =="
}

case "${1:-estado}" in
  estado|status) estado ;;
  resumo) resumo ;;
  logs) exec journalctl -u legis.service -f ;;
  reiniciar) root reiniciar; reiniciar; [ -d /run/systemd/system ] && systemctl restart legis-radio.service 2>/dev/null; echo "reiniciado" ;;
  reconfigurar) root reconfigurar; exec dpkg-reconfigure legis ;;
  extras) extras ;;
  importar-portal)   # sessões, matérias e ex-vereadores do portal legislativomunicipal.com (atualiza o que já existe)
    root importar-portal
    importar_portal "${2:-}" ;;
  certificado)   # kit do certificado para os aparelhos sem internet; com destino, copia (ex.: pendrive)
    root certificado
    KIT="$DADOS/certificado-aparelhos"
    if [ ! -f "$KIT/LEGIS-certificado.crt" ]; then
      runuser -u legis -- bash -c 'set -a; . "$1"; set +a; exec python3 "$2/server/servidor.py" --kit-certificado "$3"' _ "$ENVF" "$APP" "$KIT" >/dev/null
    fi
    if [ -n "${2:-}" ]; then
      [ -d "$2" ] || { echo "Pasta de destino não existe: $2"; exit 1; }
      cp "$KIT"/* "$2"/ && echo "Kit do certificado copiado para $2"
    else
      echo "Kit do certificado (copie para um pendrive: sudo legis certificado /media/<pendrive>):"; ls -1 "$KIT" | sed 's/^/  /'
    fi ;;
  modelo)   # modelo da cidade: mostra qual está em uso; --reaplicar aplica de novo as preferências ao banco
    M=$(le LEGIS_MODELO "$ENVF")
    [ -n "$M" ] || { echo "Esta instalação não usa modelo de cidade."; exit 0; }
    python3 "$APP/packaging/modelo.py" validar "$M"
    if [ "${2:-}" = "--reaplicar" ]; then
      root modelo
      [ -d /run/systemd/system ] && systemctl stop legis.service
      runuser -u legis -- bash -c 'set -a; . "$1"; set +a; exec python3 "$2/server/servidor.py" --reaplicar-modelo' _ "$ENVF" "$APP"
      reiniciar
    fi ;;
  importar-tse)
    root importar-tse
    [ $# -ge 3 ] || { echo 'Uso: sudo legis importar-tse UF "Município"'; exit 1; }
    [ ! -f "$DADOS/legis.db" ] || { echo "Já existe um banco em $DADOS/legis.db (a importação só cria banco novo)."; exit 1; }
    [ -d /run/systemd/system ] && systemctl stop legis.service
    runuser -u legis -- env PARLATORIO_BANCO="$DADOS/legis.db" TRANSCRICAO=0 python3 "$APP/scripts/tse_eleitos.py" "$2" "$3" "$DADOS/legis.db"
    reiniciar ;;
  ajuda|-h|--help) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) echo "Comando desconhecido: $1 (legis ajuda)"; exit 1 ;;
esac
