#!/bin/bash
# Administração do LEGIS instalado pelo pacote .deb.
#   legis              estado, endereços e o que está instalado
#   legis logs         registro do serviço (Ctrl-C para sair)
#   legis reiniciar    reinicia o serviço
#   legis importar-tse UF "Município"   vereadores eleitos (só num banco vazio)
#   legis configurar-cidade [UF "Município"]   importa a Câmara e os vereadores eleitos
#   legis reconfigurar perguntas da instalação de novo (dpkg-reconfigure legis)
#   legis extras       instala transcrição, IA local e publicação na internet escolhidas
set -euo pipefail
APP=/opt/legis
DADOS=/var/lib/legis
ETC=/etc/legis
ENVF=$ETC/legis.env
LOG=/var/log/legis-extras.log

le() { grep -E "^$1=" "$2" 2>/dev/null | tail -1 | cut -d= -f2-; }
root() { [ "$(id -u)" = 0 ] || { echo "Use: sudo legis $*"; exit 1; }; }
reiniciar() { if [ -d /run/systemd/system ]; then systemctl restart legis.service; fi; }

verificar_instalacao() {
  local porta
  porta=$(le PORTA "$ENVF")
  for _ in $(seq 1 30); do
    if systemctl is-active --quiet legis.service &&
       curl -fsS --max-time 2 "http://127.0.0.1:$porta/api/transparencia" 2>/dev/null |
         python3 -c 'import json,sys; d=json.load(sys.stdin); sys.exit(not all(k in d for k in ("casa", "projetos", "sessoes")))' 2>/dev/null; then
      return 0
    fi
    sleep 1
  done
  echo "O serviço Legis não respondeu na porta $porta. Veja: sudo journalctl -u legis.service -n 40 --no-pager" >&2
  return 1
}

configurar_cidade() {
  root configurar-cidade
  if [ ! -f "$DADOS/.sem-municipio" ]; then
    echo "A instalação já está configurada."
    return 0
  fi
  local uf municipio
  if [ "$#" = 0 ]; then
    [ -t 0 ] || { echo 'Use: sudo legis configurar-cidade UF "Município"'; return 1; }
    echo "Escolha o município para importar os vereadores eleitos do TSE."
    read -rp "UF (ex.: MA): " uf
    read -rp "Município: " municipio
  elif [ "$#" = 2 ]; then
    uf=$1; municipio=$2
  else
    echo 'Use: sudo legis configurar-cidade UF "Município"'
    return 1
  fi
  uf=${uf,,}
  [[ "$uf" =~ ^[a-z]{2}$ && -n "$municipio" && "$municipio" != *$'\n'* && "$municipio" != *$'\r'* ]] ||
    { echo 'Informe a sigla do estado e o nome do município.'; return 1; }
  debconf-set-selections <<EOF
legis legis/uf string $uf
legis legis/municipio string $municipio
EOF
  LEGIS_CONFIGURADOR=1 dpkg-reconfigure --frontend=noninteractive legis
  verificar_instalacao
  if [ -f "$DADOS/.sem-municipio" ]; then
    echo "A cidade continua pendente. Confira a UF, o município e a conexão e tente novamente." >&2
    return 1
  fi
}

preparar_radio() {
  root preparar-radio
  local azura="${1:-sim}" modo="${2:-serve}" falhou=0
  [[ "$azura" == sim || "$azura" == nao ]] && [[ "$modo" == serve || "$modo" == funnel ]] ||
    { echo 'Uso: sudo legis preparar-radio [sim|nao] [serve|funnel]'; return 1; }
  local porta_azura=""
  # A configuração da rádio é separada do trabalho de transcrição e IA para deixar o resultado visível.
  exec 8>"$ETC/.preparar-radio.lock"
  flock 8
  if [ "$azura" = sim ]; then
    echo "Preparando AzuraCast e a estação Rádio da Câmara..."
    if python3 "$APP/deploy/azuracast/provisionar.py" "$ETC/azuracast" "$ENVF"; then
      porta_azura=$(le LEGIS_AZURACAST_WEB "$ENVF")
      reiniciar
      verificar_instalacao || falhou=1
      echo "AzuraCast no servidor: http://127.0.0.1:$porta_azura"
    else
      falhou=1
    fi
  fi
  local -a proxy=(bash "$APP/deploy/tailscale/instalar-proxy.sh" "$DADOS" "$ETC" "$(hostname -s)"
    "$(le PORTA_HTTPS "$ENVF")" "$porta_azura" "$modo")
  local codigo=0
  "${proxy[@]}" || codigo=$?
  if [ "$codigo" = 2 ]; then
    if ! systemctl is-active --quiet legis-autorizar-proxy.service; then
      systemd-run --quiet --collect --unit=legis-autorizar-proxy /usr/sbin/legis aguardar-proxy "$porta_azura" "$modo"
    fi
  elif [ "$codigo" != 0 ]; then
    falhou=1
  fi
  return "$falhou"
}

aguardar_proxy() {
  root aguardar-proxy
  for _ in $(seq 1 240); do
    if docker exec legis-tailscale tailscale status --json 2>/dev/null |
       python3 -c 'import json,sys; sys.exit(json.load(sys.stdin).get("BackendState") != "Running")' 2>/dev/null; then
      exec bash "$APP/deploy/tailscale/instalar-proxy.sh" "$DADOS" "$ETC" "$(hostname -s)" \
        "$(le PORTA_HTTPS "$ENVF")" "$1" "$2"
    fi
    sleep 15
  done
  echo "A autorização do Tailscale continua pendente. Use sudo legis preparar-radio para retomar."
  return 1
}

resumo() {
  local http https ip pin url
  http=$(le PORTA "$ENVF"); https=$(le PORTA_HTTPS "$ENVF"); pin=$(le PIN_PRESIDENTE "$ENVF")
  ip=$(hostname -I 2>/dev/null | awk '{print $1}')
  url=$(cat "$ETC/endereco-internet" 2>/dev/null || true)
  local azura; azura=$(cat "$ETC/endereco-azuracast" 2>/dev/null || true)
  local suf=""; [ "$https" != "443" ] && suf=":$https"
  cat <<EOF

 LEGIS — Sistema de Gestão Parlamentar
 ------------------------------------------------------------------
 Rede da Câmara:  https://$(hostname).local$suf   (ou https://$ip$suf)
 Internet:        ${url:-não publicado (sudo dpkg-reconfigure legis, com a chave do Tailscale)}
 AzuraCast:        ${azura:-painel via Tailscale após autorização}
 Presidente:      /presidente — PIN inicial: ${pin:-?} (troque no primeiro acesso)
 Vereadores:      /parlamentar — PIN inicial 0000 (troca obrigatória)
 Rádio:           $( grep -q '^RADIO_LOCAL=1' "$ENVF" 2>/dev/null && echo "https://$(hostname).local$suf/radio.mp3 (programação em Configurações → Rádio da Câmara)" || echo "não instalada")
 Certificado:     instale em cada aparelho: http://$ip:${http:-80}/certificado
 Checklist:       /usr/share/doc/legis/README.md
EOF
  if [ -f "$DADOS/.sem-municipio" ]; then
    cat <<EOF

 PRÓXIMO PASSO: escolher a cidade. Abra o painel do presidente (endereço acima +
 /presidente): a caixa "De qual cidade é esta Câmara?" traz os vereadores do TSE.
 (ou, no servidor: sudo dpkg-reconfigure legis)
EOF
  fi
}

estado() {
  resumo
  echo " ------------------------------------------------------------------"
  if [ -d /run/systemd/system ]; then
    printf " Serviço:         %s\n" "$(systemctl is-active legis.service 2>/dev/null || true)"
    printf " Instalação extra: %s\n" "$(systemctl is-active legis-extras.service 2>/dev/null | sed 's/inactive/concluída/;s/activating\|active/em andamento/')"
  fi
  [ -x "$DADOS/whisper/bin/python" ] && echo " Transcrição:     instalada" || echo " Transcrição:     não instalada"
  grep -q '^IA=ollama' "$ENVF" 2>/dev/null && echo " IA local:        instalada (Ollama)" || echo " IA local:        não instalada"
  if grep -q '^JITSI_URL=' "$ENVF" 2>/dev/null; then echo " Videoconferência: $(grep '^JITSI_URL=' "$ENVF" | cut -d= -f2-)"; else echo " Videoconferência: não instalada"; fi
  grep -q '^LEGIS_YOUTUBE_CHAVE=' "$ENVF" 2>/dev/null && echo " YouTube:         chave configurada (botão Transmitir do painel)" || echo " YouTube:         cole a chave em Configurações → YouTube ao vivo"
  if grep -q '^RADIO_LOCAL=1' "$ENVF" 2>/dev/null; then
    printf " Rádio:           %s — /radio.mp3, %s arquivo(s) na programação\n" \
      "$( [ -d /run/systemd/system ] && systemctl is-active legis-radio.service 2>/dev/null || echo instalada)" \
      "$(find "$DADOS/radio/programacao" -type f 2>/dev/null | wc -l)"
  else
    echo " Rádio:           não instalada"
  fi
  [ -f "$LOG" ] && { echo " Últimas linhas de $LOG:"; tail -3 "$LOG" | sed 's/^/   /'; }
  echo
}

extras() {
  root extras
  exec >>"$LOG" 2>&1
  echo "== $(date '+%F %T') instalação extra =="
  # shellcheck disable=SC1090
  . "$ETC/instalacao.conf"
  local mudou=0
  if [ "${TRANSCRICAO:-false}" = "true" ] && [ ! -x "$DADOS/whisper/bin/python" ]; then
    echo "transcrição: instalando faster-whisper e o modelo small..."
    runuser -u legis -- env PARLATORIO_DADOS="$DADOS" HOME="$DADOS" HF_HOME="$DADOS/hf" sh "$APP/scripts/instalar_transcricao.sh" && mudou=1
  fi
  if [ "${IA:-false}" = "true" ] && ! grep -q '^IA=ollama' "$ENVF"; then
    if command -v docker >/dev/null; then
      echo "IA: iniciando o Ollama e baixando qwen2.5:3b (cerca de 2 GB)..."
      docker inspect legis-ollama >/dev/null 2>&1 || docker run -d --name legis-ollama --restart unless-stopped \
        -e OLLAMA_KEEP_ALIVE=30m -p 127.0.0.1:11434:11434 -v "$DADOS/ollama:/root/.ollama" ollama/ollama
      sleep 5
      docker exec legis-ollama ollama pull qwen2.5:3b
      printf 'IA=ollama\nOLLAMA_URL=http://127.0.0.1:11434\nIA_MODELO=qwen2.5:3b\n' >> "$ENVF"
      mudou=1
    else
      echo "IA: o Docker não está instalado (sudo apt install docker.io) — pulando."
    fi
  fi
  if [ "${JITSI:-false}" = "true" ] && ! grep -q '^JITSI_URL=' "$ENVF"; then
    if command -v docker >/dev/null; then
      echo "videoconferência: instalando o Jitsi da Câmara (cerca de 1 GB)..."
      ENVF="$ENVF" SERVICO=legis SEM_REINICIAR=1 JITSI_DIR="$DADOS/jitsi" DADOS="$DADOS" bash "$APP/deploy/jitsi/instalar-jitsi.sh" && mudou=1
    else
      echo "videoconferência: o Docker não está instalado (sudo apt install docker.io) — pulando."
    fi
  fi
  [ "$mudou" = 1 ] && reiniciar
  echo "== concluído =="
}

case "${1:-estado}" in
  estado|status) estado ;;
  resumo) resumo ;;
  verificar-instalacao) verificar_instalacao ;;
  cidade-pendente) [ -f "$DADOS/.sem-municipio" ] ;;
  configurar-cidade) shift; configurar_cidade "$@" ;;
  preparar-radio) shift; preparar_radio "$@" ;;
  aguardar-proxy) shift; aguardar_proxy "$@" ;;
  logs) exec journalctl -u legis.service -f ;;
  reiniciar) root reiniciar; reiniciar; [ -d /run/systemd/system ] && systemctl restart legis-radio.service 2>/dev/null; echo "reiniciado" ;;
  reconfigurar) root reconfigurar; exec dpkg-reconfigure legis ;;
  extras) extras ;;
  importar-tse)
    root importar-tse
    [ $# -ge 3 ] || { echo 'Uso: sudo legis importar-tse UF "Município"'; exit 1; }
    [ ! -f "$DADOS/legis.db" ] || { echo "Já existe um banco em $DADOS/legis.db (a importação só cria banco novo)."; exit 1; }
    [ -d /run/systemd/system ] && systemctl stop legis.service
    runuser -u legis -- env PARLATORIO_BANCO="$DADOS/legis.db" TRANSCRICAO=0 python3 "$APP/scripts/tse_eleitos.py" "$2" "$3" "$DADOS/legis.db"
    reiniciar ;;
  ajuda|-h|--help) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) echo "Comando desconhecido: $1 (legis ajuda)"; exit 1 ;;
esac
